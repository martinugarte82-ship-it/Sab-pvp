--========================================================
-- BUSCAR HUMANOID MÁS CERCANO
--========================================================

local function getNearestHumanoid()

	if not rootPart then

		return nil,
			math.huge
	end

	local nearestHumanoid =
		nil

	local nearestDistance =
		math.huge

	for _, object in ipairs(
		Workspace:GetDescendants()
	) do

		if object:IsA(
			"Humanoid"
		)
		and object ~= humanoid
		and object.Health > 0 then

			local model =
				object.Parent

			if model
				and model:IsA(
					"Model"
				) then

				local targetRoot =
					model:FindFirstChild(
						"HumanoidRootPart"
					)
					or
					model:FindFirstChild(
						"UpperTorso"
					)
					or
					model:FindFirstChild(
						"Torso"
					)

				if targetRoot
					and targetRoot:IsA(
						"BasePart"
					) then

					local distance =
						(
							rootPart.Position
							-
							targetRoot.Position
						).Magnitude

					if distance <
						nearestDistance then

						nearestDistance =
							distance

						nearestHumanoid =
							object
					end
				end
			end
		end
	end

	return nearestHumanoid,
		nearestDistance
end

--========================================================
-- MIRAR AL OBJETIVO
--========================================================

local function lookAtTarget(
	targetRoot
)

	if not rootPart
		or not targetRoot then

		return
	end

	local currentPosition =
		rootPart.Position

	-- Mirar horizontalmente.
	-- No inclina el personaje.
	local lookPosition =
		Vector3.new(
			targetRoot.Position.X,
			currentPosition.Y,
			targetRoot.Position.Z
		)

	local direction =
		lookPosition
		-
		currentPosition

	if direction.Magnitude <=
		0.001 then

		return
	end

	rootPart.CFrame =
		CFrame.lookAt(
			currentPosition,
			lookPosition
		)
end
	
--========================================================
-- BUSCAR BATE
--========================================================

local function findBat()
    local character = player.Character
    if not character then
        return nil
    end

    -- Buscar primero en el personaje
    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("Tool") and string.find(string.lower(obj.Name), "bat") then
            return obj
        end
    end

    -- Buscar en la mochila
    local backpack = player:FindFirstChildOfClass("Backpack")

    if backpack then
        for _, obj in ipairs(backpack:GetChildren()) do
            if obj:IsA("Tool") and string.find(string.lower(obj.Name), "bat") then
                return obj
            end
        end
    end

    return nil
end


--========================================================
-- USAR BATE
--========================================================

local function useBat()
    local character = player.Character
    if not character then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return
    end

    local bat = findBat()

    if not bat then
        return
    end

    -- Equipar si está en la mochila
    if bat.Parent ~= character then
        humanoid:EquipTool(bat)
        task.wait(0.05)
    end

    -- Activar el bate
    if bat.Parent == character then
        pcall(function()
            bat:Activate()
        end)
    end
end


--========================================================
-- BUSCAR JUGADOR MÁS CERCANO
--========================================================

local function getNearestTarget()
    local character = player.Character
    if not character then
        return nil
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then
        return nil
    end

    local nearestTarget = nil
    local nearestDistance = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Health > 0 then

            local targetCharacter = obj.Parent

            if targetCharacter
                and targetCharacter:IsA("Model")
                and targetCharacter ~= character then

                local targetRoot =
                    targetCharacter:FindFirstChild("HumanoidRootPart")

                if targetRoot then

                    local distance =
                        (root.Position - targetRoot.Position).Magnitude

                    if distance < nearestDistance then
                        nearestDistance = distance
                        nearestTarget = targetCharacter
                    end
                end
            end
        end
    end

    return nearestTarget
end


--========================================================
-- AUTO BAT
--========================================================

local autoBatRunning = false

local function startAutoBat()

    if autoBatRunning then
        return
    end

    autoBatRunning = true

    task.spawn(function()

        while autoBatRunning do

            local character = player.Character

            if not character then
                task.wait()
                continue
            end

            local humanoid =
                character:FindFirstChildOfClass("Humanoid")

            local root =
                character:FindFirstChild("HumanoidRootPart")

            if not humanoid or not root then
                task.wait()
                continue
            end

            local target = getNearestTarget()

            if target then

                local targetRoot =
                    target:FindFirstChild("HumanoidRootPart")

                local targetHumanoid =
                    target:FindFirstChildOfClass("Humanoid")

                if targetRoot
                    and targetHumanoid
                    and targetHumanoid.Health > 0 then

                    --================================================
                    -- MIRAR AL OBJETIVO
                    --================================================

                    local targetPosition = targetRoot.Position

                    local lookPosition = Vector3.new(
                        targetPosition.X,
                        root.Position.Y,
                        targetPosition.Z
                    )

                    root.CFrame =
                        CFrame.lookAt(
                            root.Position,
                            lookPosition
                        )


                    --================================================
                    -- MOVERSE HACIA EL OBJETIVO
                    --================================================

                    humanoid:MoveTo(targetPosition)


                    --================================================
                    -- DISTANCIA PARA USAR EL BATE
                    --================================================

                    local distance =
                        (root.Position - targetRoot.Position).Magnitude

                    if distance <= AUTO_BAT_DISTANCE then

                        useBat()

                        task.wait(PROXIMITY_DELAY)

                    else

                        task.wait()

                    end
                else
                    task.wait()
                end

            else
                task.wait()
            end
        end
    end)
end


--========================================================
-- DETENER AUTO BAT
--========================================================

local function stopAutoBat()

    autoBatRunning = false

    local character = player.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if humanoid then

        humanoid.AutoRotate = true

        -- Restaurar velocidad seleccionada
        humanoid.WalkSpeed = currentSpeed

        -- Volver a permitir escalar
        pcall(function()
            humanoid:SetStateEnabled(
                Enum.HumanoidStateType.Climbing,
                true
            )
        end)
    end
end


