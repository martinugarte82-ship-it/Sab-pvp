		NumberSequence.new(0.45)
	beam.Color =
		ColorSequence.new(Color3.new(0, 0, 0))
	beam.Parent = part

	table.insert(ringParts, {
		part = part,
		a0 = attachment0,
		a1 = attachment1,
		beam = beam
	})
end

--========================================================
-- ACTUALIZAR CÍRCULO
--========================================================

RunService.RenderStepped:Connect(function()

	local character = player.Character

	if not character then
		return
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	local bottomY =
		root.Position.Y - 3

	local radius =
		FAST_PRELOAD_DISTANCE

	for i, data in ipairs(ringParts) do

		local a1 =
			((i - 1) / RING_SEGMENTS)
			* math.pi * 2

		local a2 =
			(i / RING_SEGMENTS)
			* math.pi * 2

		local p1 = Vector3.new(
			root.Position.X
				+ math.cos(a1) * radius,
			bottomY + 0.15,
			root.Position.Z
				+ math.sin(a1) * radius
		)

		local p2 = Vector3.new(
			root.Position.X
				+ math.cos(a2) * radius,
			bottomY + 0.15,
			root.Position.Z
				+ math.sin(a2) * radius
		)

		data.part.Position = p1

		data.a0.WorldPosition = p1
		data.a1.WorldPosition = p2
	end
end)

--========================================================
-- ACTUALIZAR PORCENTAJE SUPERIOR
--========================================================

RunService.RenderStepped:Connect(function()

	if not FAST_PROMPTS_ENABLED then
		fastFill.Size =
			UDim2.new(0, 0, 1, 0)

		fastText.Text = "0%"
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	local bestProgress = 0

	for _, prompt in ipairs(
		workspace:GetDescendants()
	) do

		if prompt:IsA("ProximityPrompt")
			and not isPlayerCharacterPrompt(prompt) then

			local parent = prompt.Parent

			if parent
				and parent:IsA("BasePart") then

				local distance =
					(root.Position - parent.Position).Magnitude

				if distance <= FAST_PRELOAD_DISTANCE then

					local progress =
						1 - (
							distance
							/ FAST_PRELOAD_DISTANCE
						)

					bestProgress =
						math.max(
							bestProgress,
							progress
						)
				end
			end
		end
	end

	fastFill.Size =
		UDim2.new(
			bestProgress,
			0,
			1,
			0
		)

	fastText.Text =
		tostring(
			math.floor(bestProgress * 100)
		) .. "%"
end)

