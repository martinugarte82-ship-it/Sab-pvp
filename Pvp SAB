	if obj:IsA("ProximityPrompt") then
		preparePrompt(obj)
	end
end

--========================================================
-- ACTIVACIÓN RÁPIDA DE PROMPTS
--========================================================

ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)

	if not FAST_PROMPTS_ENABLED then
		return
	end

	if isPlayerCharacterPrompt(prompt) then
		return
	end

	if promptCooldowns[prompt] then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	local parent = prompt.Parent

	if not parent:IsA("BasePart") then
		return
	end

	local distance =
		(root.Position - parent.Position).Magnitude

	if distance <= FAST_PRELOAD_DISTANCE then

		promptCooldowns[prompt] = true

		task.spawn(function()

			local originalDuration =
				prompt.HoldDuration

			prompt.HoldDuration =
				FAST_FINAL_HOLD

			pcall(function()
				prompt:InputHoldBegin()
			end)

			task.wait(FAST_FINAL_HOLD)

			pcall(function()
				prompt:InputHoldEnd()
			end)

			prompt.HoldDuration =
				FAST_FINAL_HOLD

			task.wait(FAST_PROMPT_COOLDOWN)

			promptCooldowns[prompt] = nil
		end)
	end
end)

