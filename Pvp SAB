				if connectedToCharacter then

					local box =
						nil

					if part0
						and not part0:IsDescendantOf(
							character
						) then

						box =
							part0

					elseif part1
						and not part1:IsDescendantOf(
							character
						) then

						box =
							part1
					end

					object:Destroy()

					if box
						and box:IsA(
							"BasePart"
						) then

						box.Anchored =
							false

						box.CanCollide =
							true
					end
				end
			end
		end
