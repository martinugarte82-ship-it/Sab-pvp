local autoBatRunning = false

local function findBat()

	local character = player.Character

	if not character then
		return nil
	end

	-- Buscar en personaje
	for _, obj in ipairs(character:GetChildren()) do

		if obj:IsA("Tool")
			and string.find(string.lower(obj.Name), "bat") then

			return obj
		end
	end

	-- Buscar en mochila
	local backpack =
		player:FindFirstChildOfClass("Backpack")

	if backpack then

		for _, obj in ipairs(backpack:GetChildren()) do

			if obj:IsA("Tool")
				and string.find(string.lower(obj.Name), "bat") then

				return obj
			end
		end
	end

	return nil
end

--========================================================
-- AUTO BAT - USAR BATE
-- PARTE 2/2
--========================================================

local function useBat()

	local character = player.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	local bat = findBat()

	if not bat then
		return
	end

	if bat.Parent ~= character then

		humanoid:EquipTool(bat)

		task.wait(0.05)
	end

	if bat.Parent == character then

		pcall(function()
			bat:Activate()
		end)

	end
end

--========================================================
-- BUSCAR OBJETIVO
--========================================================

local function getNearestTarget()

	local character = player.Character

	if not character then
		return nil
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return nil
	end

	local nearestTarget = nil
	local nearestDistance = math.huge

	for _, obj in ipairs(workspace:GetDescendants()) do

		if obj:IsA("Humanoid")
			and obj.Health > 0 then

			local targetCharacter = obj.Parent

			if targetCharacter
				and targetCharacter:IsA("Model")
				and targetCharacter ~= character then

				local targetRoot =
					targetCharacter:FindFirstChild(
						"HumanoidRootPart"
					)

				if targetRoot then

					local distance =
						(root.Position - targetRoot.Position).Magnitude

					if distance < nearestDistance then

						nearestDistance = distance
						nearestTarget = targetCharacter

					end
				end
			end
		end
	end

	return nearestTarget
end

--========================================================
-- INICIAR AUTO BAT
--========================================================

local function startAutoBat()

	if autoBatRunning then
		return
	end

	autoBatRunning = true

	task.spawn(function()

		while autoBatRunning do

			local character = player.Character

			if not character then
				task.wait()
				continue
			end

			local humanoid =
				character:FindFirstChildOfClass("Humanoid")

			local root =
				character:FindFirstChild("HumanoidRootPart")

			if not humanoid or not root then
				task.wait()
				continue
			end

			local target = getNearestTarget()

			if target then

				local targetRoot =
					target:FindFirstChild(
						"HumanoidRootPart"
					)

				local targetHumanoid =
					target:FindFirstChildOfClass(
						"Humanoid"
					)

				if targetRoot
					and targetHumanoid
					and targetHumanoid.Health > 0 then

					-- Mirar al objetivo
					local targetPosition =
						targetRoot.Position

					local lookPosition =
						Vector3.new(
							targetPosition.X,
							root.Position.Y,
							targetPosition.Z
						)

					root.CFrame =
						CFrame.lookAt(
							root.Position,
							lookPosition
						)

					-- Avanzar hacia él
					humanoid.WalkSpeed =
						AUTO_BAT_SPEED

					humanoid:MoveTo(targetPosition)

					-- Usar bate cuando está cerca
					local distance =
						(root.Position - targetRoot.Position).Magnitude

					if distance <= AUTO_BAT_DISTANCE then

						useBat()

						task.wait(
							PROXIMITY_DELAY
						)

					else

						task.wait()

					end

				else
					task.wait()
				end

			else
				task.wait()
			end
		end
	end)
end

--========================================================
-- DETENER AUTO BAT
--========================================================

local function stopAutoBat()

	autoBatRunning = false

	local character = player.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if humanoid then

		humanoid.AutoRotate = true
		humanoid.WalkSpeed = currentSpeed

		pcall(function()

			humanoid:SetStateEnabled(
				Enum.HumanoidStateType.Climbing,
				true
			)

		end)
	end
end

