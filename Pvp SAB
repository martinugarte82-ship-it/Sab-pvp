--========================================================
-- FAST PROXIMITY PROMPTS
--========================================================

local preparedPrompts = {}
local promptCooldowns = {}

local function isPlayerCharacterPrompt(prompt)

	local character = player.Character

	if not character then
		return false
	end

	return prompt:IsDescendantOf(character)
end

local function preparePrompt(prompt)

	if not FAST_PROMPTS_ENABLED then
		return
	end

	if not prompt:IsDescendantOf(workspace) then
		return
	end

	if isPlayerCharacterPrompt(prompt) then
		return
	end

	if preparedPrompts[prompt] then
		return
	end

	preparedPrompts[prompt] = true

	task.spawn(function()

		local startTime = os.clock()

		while preparedPrompts[prompt]
			and prompt.Parent
			and FAST_PROMPTS_ENABLED do

			local character = player.Character

			if not character then
				task.wait()
				continue
			end

			local root =
				character:FindFirstChild(
					"HumanoidRootPart"
				)

			if not root then
				task.wait()
				continue
			end

			local part = prompt.Parent

			if not part:IsA("BasePart") then
				preparedPrompts[prompt] = nil
				break
			end

			local distance =
				(root.Position - part.Position).Magnitude

			if distance <= FAST_PRELOAD_DISTANCE then

				local progress =
					math.clamp(
						(os.clock() - startTime)
							/ FAST_PREP_TIME,
						0,
						1
					)

				-- Preparación simulada del cliente
				if progress >= 1 then
					break
				end

			else

				-- Si se aleja, reiniciar preparación
				startTime = os.clock()

			end

			task.wait()
		end
	end)
end

-- Detectar prompts nuevos
workspace.DescendantAdded:Connect(function(obj)

	if obj:IsA("ProximityPrompt") then
		preparePrompt(obj)
	end
end)

-- Detectar prompts que ya existen
