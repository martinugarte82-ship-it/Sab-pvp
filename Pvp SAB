local function updateUIScale()
	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local viewport = camera.ViewportSize

	-- Ajuste especial para teléfonos
	if viewport.X < 600 then
		uiScale.Scale = math.clamp(viewport.X / 430, 0.78, 1)
	else
		uiScale.Scale = 1
	end
end

