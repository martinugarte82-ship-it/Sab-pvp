local function setupCharacter(char)

	character = char

	humanoid =
		char:WaitForChild(
			"Humanoid",
			10
		)

	rootPart =
		char:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if humanoid then

		humanoid.WalkSpeed =
			currentSpeed

		humanoid.UseJumpPower =
			true

		humanoid.JumpPower =
			currentJump

		humanoid.AutoRotate =
			true

		-- Por defecto se permite escalar.
		humanoid:SetStateEnabled(
			Enum.HumanoidStateType.Climbing,
			true
		)
	end
end

