local function createSlider(name, y, defaultValue)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -24, 0, 24)
	label.Position = UDim2.fromOffset(12, y)
	label.BackgroundTransparency = 1
	label.Text = name .. ": " .. tostring(math.floor(defaultValue))
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextSize = 14
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = panel

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, -24, 0, 14)
	bar.Position = UDim2.fromOffset(12, y + 27)
	bar.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	bar.BorderSizePixel = 0
	bar.Parent = panel

	addCorner(bar, 7)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(
		math.clamp(defaultValue / MAX_VALUE, 0, 1),
		0,
		1,
		0
	)
	fill.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
	fill.BorderSizePixel = 0
	fill.Parent = bar

	addCorner(fill, 7)

	-- Botón invisible grande para facilitar toque en teléfono
	local touchButton = Instance.new("TextButton")
	touchButton.Size = UDim2.new(1, 0, 0, 32)
	touchButton.Position = UDim2.fromOffset(0, -9)
	touchButton.BackgroundTransparency = 1
	touchButton.Text = ""
	touchButton.AutoButtonColor = false
	touchButton.Parent = bar

	local value = defaultValue

	local function setValueFromX(x)
		local relative = math.clamp(
			(x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
			0,
			1
		)

		value = math.floor(relative * MAX_VALUE)

		fill.Size = UDim2.new(relative, 0, 1, 0)
		label.Text = name .. ": " .. tostring(value)

		return value
	end

	local dragging = false

	touchButton.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			setValueFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging then
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then

				setValueFromX(input.Position.X)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
		end
	end)

	return function()
		return value
	end
end

